{
  "name": "ai-wrapped-year",
  "version": "0.4.2",
  "description": "Your year with AI coding tools, computed on your own machine from the logs they already keep.",
  "type": "module",
  "bin": {
    "ai-wrapped-year": "bin/agent-wrapped.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "site": "node bin/agent-wrapped.js --data site/demo.json --out _site/demo.html --no-open && cp site/index.html _site/"
  },
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "wrapped",
    "ai",
    "claude-code",
    "codex",
    "cursor",
    "antigravity",
    "grok",
    "gemini-cli",
    "opencode",
    "copilot",
    "amp",
    "usage",
    "stats"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IamDejman/ai-wrapped-year.git"
  },
  "bugs": "https://github.com/IamDejman/ai-wrapped-year/issues",
  "homepage": "https://aiyearwrapped.com/",
  "license": "MIT"
}
